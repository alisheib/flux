generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Organization (Multi-tenant) ───────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  currency  String   @default("USD")
  locale    String   @default("en")
  taxRate   Float    @default(0)
  taxLabel  String   @default("TVA")
  address   String?
  phone     String?
  email     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  shipments    Shipment[]
  products     Product[]
  categories   Category[]
  sales        Sale[]
  invoices     Invoice[]
  settings     OrgSettings?
  subscription Subscription?
  auditLogs      AuditLog[]
  expenses       ShipmentExpense[]
  stockMovements StockMovement[]
  creditNotes    CreditNote[]
  payments       Payment[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  importTemplates ImportTemplate[]
  importJobs      ImportJob[]
  customers       Customer[]
}

// ─── Users & Auth ──────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  orgId             String
  email             String    @unique
  password          String
  name              String
  role              String    @default("salesman")
  avatar            String?
  active            Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  verificationToken String?
  lastLogin         DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sales          Sale[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  @@index([orgId])
  @@index([email])
}

// ─── Shipments (Import Costing) ────────────────────────────────────────────

model Shipment {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  dossierNumber   String?
  invoiceNumber   String?
  containerNumber String?
  containerType   String   @default("20HC")
  containerCount  Int      @default(1)
  supplier        String?
  origin          String   @default("China")
  exchangeRate    Float    @default(2630)
  status          String   @default("clearing")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items    ShipmentItem[]
  expenses ShipmentExpense[]

  @@index([orgId])
}

model ShipmentItem {
  id         String  @id @default(cuid())
  shipmentId String
  productId  String?
  name       String
  thickness  Float?
  width      Float?
  height     Float?
  color      String?
  unit       String  @default("sheet")
  quantity   Int
  unitCost   Float
  totalCost  Float
  notes      String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([productId])
}

model ShipmentExpense {
  id          String @id @default(cuid())
  orgId       String
  shipmentId  String
  category    String
  description String
  amountLocal Float  @default(0)
  amountUsd   Float  @default(0)
  notes       String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shipment Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([orgId])
}

// ─── Products & Inventory ──────────────────────────────────────────────────

model Category {
  id     String  @id @default(cuid())
  orgId  String
  name   String
  icon   String?
  color  String?
  fields String? // JSON array of enabled optional product fields, e.g. ["thickness","width","height","color"]

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([orgId])
}

model Product {
  id           String   @id @default(cuid())
  orgId        String
  categoryId   String?
  sku          String?
  name         String
  description  String?
  unit         String   @default("piece")
  thickness    Float?
  width        Float?
  height       Float?
  color        String?
  sqmPerUnit   Float?
  costPrice    Float    @default(0)
  sellingPrice Float    @default(0)
  pricePerSqm  Float?
  stockQty     Float    @default(0)
  minStockQty  Float    @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shipmentItems      ShipmentItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([orgId, sku])
  @@index([orgId])
  @@index([categoryId])
}

// ─── Sales & POS ───────────────────────────────────────────────────────────

model Sale {
  id            String   @id @default(cuid())
  orgId         String
  userId        String
  customerId    String?
  invoiceId     String?  @unique
  saleNumber    String
  customer      String?
  customerPhone String?
  customerEmail String?
  subtotal      Float
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  discount      Float    @default(0)
  total         Float
  currency      String   @default("USD")
  paymentMethod String   @default("cash")
  status        String   @default("completed")
  notes         String?
  createdAt     DateTime @default(now())

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  customerRecord Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice        Invoice?
  items          SaleItem[]
  creditNotes    CreditNote[]
  payments       Payment[]

  @@index([orgId])
  @@index([userId])
  @@index([customerId])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  name        String
  quantity    Float
  unitPrice   Float
  total       Float
  sellingUnit String  @default("unit")  // "unit" (piece/sheet/etc) or "sqm"
  area        Float?                     // actual m² sold (when sellingUnit="sqm")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// ─── Invoices ──────────────────────────────────────────────────────────────

model Invoice {
  id              String    @id @default(cuid())
  orgId           String
  saleId          String?   @unique
  customerId      String?
  number          String
  customer        String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerTin     String?
  subtotal        Float
  taxRate         Float     @default(0)
  taxAmount       Float     @default(0)
  discount        Float     @default(0)
  total           Float
  currency        String
  status          String    @default("issued")
  issuedAt        DateTime  @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  notes           String?

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sale           Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customerRecord Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([customerId])
}

// ─── Audit Log ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Subscription & Billing ────────────────────────────────────────────

model Subscription {
  id          String    @id @default(cuid())
  orgId       String    @unique
  plan        String    @default("free") // free, starter, pro, enterprise
  status      String    @default("active") // active, cancelled, past_due, trialing
  maxUsers    Int       @default(1)
  maxSalesMo  Int       @default(50) // max sales per month
  features    String?   // JSON: enabled feature flags
  trialEndsAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Organization Settings ─────────────────────────────────────────────────

model OrgSettings {
  id              String  @id @default(cuid())
  orgId           String  @unique
  defaultMargin   Float   @default(10)
  secondaryMargin Float   @default(5)
  exchangeRate    Float   @default(2630)
  invoicePrefix   String  @default("INV")
  invoiceNextNum  Int     @default(1)
  receiptPrefix   String  @default("RCP")
  receiptNextNum  Int     @default(1)
  rolePermissions String? // JSON string: { [module]: [roles] }

  // Tally / TRA Integration
  tallyEnabled    Boolean @default(false)
  tallyTin        String? // Tax Identification Number
  tallyVrn        String? // VAT Registration Number
  tallySerial     String? // EFD Serial Number
  tallyCertPath   String? // Certificate path
  tallyApiUrl     String? // TRA API endpoint
  tallyLastSync   DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Stock Movements (Inventory Audit Trail) ─────────────────────────────

model StockMovement {
  id        String   @id @default(cuid())
  orgId     String
  productId String
  userId    String?
  type      String // sale, refund, adjustment, shipment_received, manual
  quantity  Float // positive = stock in, negative = stock out
  balance   Float // stock balance after this movement
  reference String? // sale number, shipment name, credit note number
  notes     String?
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([productId])
  @@index([createdAt])
}

// ─── Credit Notes (Refunds) ──────────────────────────────────────────────

model CreditNote {
  id           String   @id @default(cuid())
  orgId        String
  saleId       String
  number       String
  reason       String
  items        String // JSON: [{productId, name, quantity, unitPrice, total}]
  subtotal     Float
  taxAmount    Float
  total        Float
  restockItems Boolean  @default(true)
  status       String   @default("issued") // issued, void
  createdAt    DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sale Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([saleId])
}

// ─── Suppliers ────────────────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  country       String?
  city          String?
  contact       String?  // Contact person name
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?  // e.g. "Net 30", "COD"
  notes         String?
  status        String   @default("active") // active, inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([orgId])
}

// ─── Purchase Orders ──────────────────────────────────────────────────────

model PurchaseOrder {
  id           String    @id @default(cuid())
  orgId        String
  supplierId   String
  poNumber     String
  status       String    @default("draft") // draft, sent, partial, received, cancelled
  expectedAt   DateTime?
  receivedAt   DateTime?
  notes        String?
  currency     String    @default("USD")
  subtotal     Float     @default(0)
  total        Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@index([orgId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String?
  name            String
  unit            String @default("piece")
  quantityOrdered Float
  quantityReceived Float  @default(0)
  unitCost        Float
  totalCost       Float
  notes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([productId])
}

// ─── Payments (Accounts Receivable) ──────────────────────────────────────

model Payment {
  id        String   @id @default(cuid())
  orgId     String
  saleId    String
  amount    Float
  method    String // mpesa, tigo, airtel, bank, cash, card
  reference String? // M-Pesa ref, bank ref, etc.
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sale Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([saleId])
}

// ─── Customers / Clients ─────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  company   String?
  tin       String?  // Tax Identification Number (e.g. 142-993-871)
  phone     String?
  email     String?
  address   String?
  tags      String?  // JSON array: ["VIP", "wholesale", "net-30"]
  notes     String?
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sales    Sale[]
  invoices Invoice[]

  @@index([orgId])
  @@index([orgId, tin])
  @@index([orgId, phone])
}

// ─── Excel Import Module ─────────────────────────────────────────────────

model ImportTemplate {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  entityType      String   // inventory, expenses, employees, transactions
  description     String?
  columnMappings  String?  // JSON: [{excelColumn, systemField, required}]
  validationRules String?  // JSON: [{field, type, required, regex, min, max, allowed, message}]
  sampleFileUrl   String?
  usageCount      Int      @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs ImportJob[]

  @@index([orgId])
}

model ImportJob {
  id          String    @id @default(cuid())
  orgId       String
  templateId  String?
  userId      String
  fileName    String
  fileUrl     String?
  totalRows   Int       @default(0)
  validRows   Int       @default(0)
  warningRows Int       @default(0)
  errorRows   Int       @default(0)
  skippedRows Int       @default(0)
  status      String    @default("pending") // pending, validating, validated, importing, completed, partial, failed
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  rowLogs  ImportRowLog[]
  diffs    ImportDiff[]

  @@index([orgId])
  @@index([templateId])
}

model ImportRowLog {
  id       String @id @default(cuid())
  jobId    String
  rowNum   Int
  status   String // valid, warning, error, skipped, imported
  data     String // JSON: the row data
  errors   String? // JSON: [{field, message, value}]
  warnings String? // JSON: [{field, message, value}]

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, status])
}

model ImportDiff {
  id        String  @id @default(cuid())
  jobId     String
  entityRef String  // e.g. product SKU or employee ID
  field     String
  before    String?
  after     String?
  kind      String  // added, changed, removed
  included  Boolean @default(true)

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
